# IP o hostname del MikroTik (idealmente alcanzable por LAN o VPN, no por internet)
MTK_HOST=192.168.88.1
MTK_USER=mktxp_user
MTK_PASSWORD=cambiar_esta_password

# 8728 = API en texto plano, 8729 = API-SSL (recomendado si el router es remoto)
MTK_PORT=8728
MTK_USE_SSL=false
# true = valida el certificado del router; false = acepta certificado self-signed
MTK_SSL_VERIFY=false

# topflows-exporter: cuantos destinos exportar y segundos entre muestreos.
# En routers con tablas de conexiones grandes (CGNAT), subir INTERVAL a 60 o mas.
TOP_N=20
INTERVAL=15

# Obligatoria: sin esto el stack no arranca (no hay default inseguro)
GRAFANA_ADMIN_PASSWORD=
